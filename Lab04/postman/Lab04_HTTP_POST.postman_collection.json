{
	"info": {
		"_postman_id": "8f2e9c14-3a5d-4882-9861-df782e4e7601",
		"name": "Lab04 HTTP POST và IoT Sensor",
		"description": "Collection cho Lab04 môn Internet of Things (IoT) - Giao thức HTTP POST, Dữ liệu Cảm biến, Xác thực, Xử lý lỗi và Flask Local Server.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
