{
  "version": 1,
  "author": "Antigravity",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -120,
      "left": 180,
      "attrs": { "temperature": "28.5", "humidity": "65" }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": 200,
      "left": 180,
      "attrs": { "pins": "i2c" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn",
      "top": 50,
      "left": 140,
      "attrs": { "color": "blue" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 120,
      "left": 140,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led",
      "top": 110,
      "left": 230,
      "attrs": { "color": "yellow" }
    }
