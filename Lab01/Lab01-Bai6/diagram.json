  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["esp:3V3", "dht:VCC", "red", []],
    ["esp:15", "dht:SDA", "green", []],
    ["dht:GND", "esp:GND.1", "black", []],

    ["esp:21", "lcd:SDA", "blue", []],
    ["esp:22", "lcd:SCL", "yellow", []],
    ["esp:5V", "lcd:VCC", "red", []],
    ["lcd:GND", "esp:GND.1", "black", []],

    ["esp:18", "btn:1.l", "blue", []],
    ["btn:2.l", "esp:GND.2", "black", []],

    ["esp:4", "r1:1", "orange", []],
    ["r1:2", "led:A", "orange", []],
    ["led:C", "esp:GND.2", "black", []]
  ],
  "dependencies": {}
