{
  "version": 1,
  "author": "Antigravity",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": -80,
      "left": 180,
      "attrs": { "pins": "i2c" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_a",
      "top": 120,
      "left": 130,
      "attrs": { "color": "green", "label": "Start/Pause" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_b",
      "top": 120,
      "left": 230,
      "attrs": { "color": "red", "label": "Reset" }
    }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["esp:21", "lcd:SDA", "blue", []],
    ["esp:22", "lcd:SCL", "yellow", []],
    ["esp:5V", "lcd:VCC", "red", []],
    ["lcd:GND", "esp:GND.1", "black", []],

    ["esp:18", "btn_a:1.l", "green", []],
    ["btn_a:2.l", "esp:GND.2", "black", []],

    ["esp:19", "btn_b:1.l", "orange", []],
    ["btn_b:2.l", "esp:GND.2", "black", []]
  ],
  "dependencies": {}
}