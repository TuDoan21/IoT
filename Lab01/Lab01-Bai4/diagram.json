{
  "version": 1,
  "author": "Antigravity",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -90,
      "left": 180,
      "attrs": { "temperature": "28.5", "humidity": "65" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 60,
      "left": 140,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "alert_led",
      "top": 50,
      "left": 230,
      "attrs": { "color": "red" }
    }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["esp:3V3", "dht:VCC", "red", []],
    ["esp:15", "dht:SDA", "green", []],
    ["dht:GND", "esp:GND.1", "black", []],

    ["esp:4", "r1:1", "red", []],
    ["r1:2", "alert_led:A", "red", []],
    ["alert_led:C", "esp:GND.2", "black", []]
  ],
  "dependencies": {}
}