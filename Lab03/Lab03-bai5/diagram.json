{
  "version": 1,
  "author": "Đoàn Tuấn Tú",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 100,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -60,
      "left": 100,
      "attrs": { "i2cAddress": "0x3c" }
    }
  ],
  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],
    ["oled:SDA", "esp:D21", "green", []],
    ["oled:SCL", "esp:D22", "blue", []],
    ["oled:VCC", "esp:3V3", "red", []],
    ["oled:GND", "esp:GND.1", "black", []]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
